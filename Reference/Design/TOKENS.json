{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "appName": "Cadence",
  "space": {
    "unit": 4,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32
  },
  "cornerRadius": {
    "button": 14,
    "card": 20,
    "hero": 24
  },
  "minTouchTargetPoints": 44,
  "typography": {
    "body": "SF Pro (system)",
    "numerals": "system monospacedDigit",
    "editorialHeadings": "New York via system rounded/serif fallback"
  },
  "themes": {
    "atelier": {
      "background": "#F7F8FC",
      "text": "#182742",
      "secondary": "#657087",
      "card": "#FFFFFF",
      "border": "#E4E8F1",
      "accent": "#2F65DB",
      "accentSoft": "#DBE7FF",
      "navigation": "#FFFFFF",
      "hero": "#182742",
      "style": "editorial-clean"
    },
    "pulse": {
      "background": "#0D1324",
      "text": "#F1F7FF",
      "secondary": "#96A6C2",
      "card": "#192338",
      "border": "#2B3953",
      "accent": "#8FE8D7",
      "accentSoft": "#243E43",
      "navigation": "#152036",
      "hero": "#213E4B",
      "style": "dark-dashboard"
    },
    "carnet": {
      "background": "#F5EFE3",
      "text": "#41372F",
      "secondary": "#897F6D",
      "card": "#FFF9EF",
      "border": "#E5D6BF",
      "accent": "#B86446",
      "accentSoft": "#F2DECA",
      "navigation": "#FFF7E9",
      "hero": "#72513A",
      "style": "warm-editorial"
    }
  },
  "states": {
    "running": "Temps écoulé",
    "paused": "En pause",
    "completed": "Terminée",
    "error": "Impossible de synchroniser l'extension"
  },
  "selectedTheme": "atelier-liquid-glass",
  "newAtelierLiquidGlass": {
    "target": "iOS 26+",
    "fallback": "iOS 17+",
    "accent": "#2776F8",
    "course": "#258BFF",
    "revision": "#7668F6",
    "text": "semantic primary",
    "secondary": "semantic secondary",
    "background": "systemGroupedBackground",
    "cardBackground": "secondarySystemGroupedBackground",
    "glassRule": "controls-navigation-only; native TabView/toolbar glass first; avoid glass content cards",
    "lightAndDark": true,
    "dynamicType": true,
    "reduceTransparency": true,
    "symbols": "SF Symbols"
  }
}
